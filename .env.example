# Variables del stack (en Portainer: Environment variables del stack)

# --- Imprescindibles ---
# Carpeta del host para el índice, las cuentas y el secreto
DATA_PATH=/mnt/user/appdata/plexmor
# Dirección pública HTTPS (proxy inverso -> puerto 7254). Vacío = se toma de cada petición
PUBLIC_URL=https://plexmor.example.com

# --- Administrador ---
# Carpeta de Plex que contiene Preferences.xml (solo lectura): el dueño del servidor queda como administrador
PLEX_CONFIG=/ruta/a/Plex Media Server
# Alternativa si Plex está en otra máquina. Sin ninguno de los dos, quien entre primero en el panel es el administrador
PLEX_TOKEN=

# --- Secretos (opcionales) ---
# Cifra los tokens guardados y firma las sesiones. Vacío = se genera uno en /data/secret
PLEXMOR_SECRET=
# Permite a Prometheus leer /metrics con "Authorization: Bearer <token>"
METRICS_TOKEN=

# --- Opciones ---
# Idioma de la interfaz y de los textos en Stremio: es | en (cada usuario puede cambiarlo en el panel)
LANGUAGE=es
# Idiomas de audio por defecto, el mejor primero. Vacío = según LANGUAGE
LANGUAGES=
TZ=Europe/Madrid
# Usuario del contenedor (99:100 es el de Unraid)
PUID=99
PGID=100
